diff -ruN a/test/tool-errors.test.ts b/test/tool-errors.test.ts
--- a/test/tool-errors.test.ts
+++ b/test/tool-errors.test.ts
@@ -0,0 +1,18 @@
+import { describe, expect, it } from "bun:test";
+import { failure } from "../src/tools/lspFormat.ts";
+import { LspResultCache } from "../src/tools/resultCache.ts";
+
+describe("LSP failures", () => {
+  it("reports a failed tool call as an error and keeps its details", () => {
+    const result = failure("lsp_definition", new Error("no server"));
+    expect(result.isError).toBe(true);
+    expect(result.content[0].text).toBe("lsp_definition failed: no server");
+    expect(result.details).toEqual({ ok: false, tool: "lsp_definition", error: "no server" });
+  });
+
+  it("reports an unknown or malformed lsp_more resultId as an error", () => {
+    const cache = new LspResultCache();
+    expect(cache.next("not-an-id").isError).toBe(true);
+    expect(cache.next("lspres_00000000-0000-4000-8000-000000000000").isError).toBe(true);
+  });
+});
