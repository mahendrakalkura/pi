diff -ruN a/test/background-resume.test.ts b/test/background-resume.test.ts
--- a/test/background-resume.test.ts
+++ b/test/background-resume.test.ts
@@ -0,0 +1,210 @@
+// Tests for the Pi fork's pi-subagents patch. The bundle installs no vitest, so these run under Bun:
+// cd packages/coding-agent/bundle/node_modules/@gotgenes/pi-subagents && bun test ./test
+
+import { describe, expect, it } from "bun:test";
+import type { ExtensionContext } from "@earendil-works/pi-coding-agent";
+import { AgentTypeRegistry } from "#src/config/agent-types";
+import { ConcurrencyLimiter } from "#src/lifecycle/concurrency-limiter";
+import { SubagentManager } from "#src/lifecycle/subagent-manager";
+import { NotificationManager } from "#src/observation/notification";
+import { SubagentEventsObserver } from "#src/observation/subagent-events-observer";
+import { AgentTool } from "#src/tools/agent-tool";
+import { GetResultTool } from "#src/tools/get-result-tool";
+import type { AgentConfig } from "#src/types";
+
+const AGENT_TYPE = "general-purpose";
+const NOTIFICATION = "subagent-notification";
+
+// Sent is one message the notification layer handed to pi.sendMessage.
+interface Sent {
+  message: { content: string; customType: string };
+  options?: { triggerTurn?: boolean };
+}
+
+// harness wires a real manager, notification layer, Agent tool and get_subagent_result tool around a fake
+// child session per agent whose first run answers "one" at once and whose resumed runs answer only when release() is called.
+function harness(config?: Pick<AgentConfig, "locked" | "runInBackground">) {
+  const sent: Sent[] = [];
+  const resumes: Array<(text: string) => void> = [];
+  const turnBudget = { phase: "within" as const, used: 1 };
+  // newSession builds one agent's session: its first run answers at once, and every later run is a
+  // resume that waits for release().
+  const newSession = () => {
+    let runs = 0;
+    return {
+      getContextPercent: () => null,
+      getSessionStats: () => ({}),
+      outputFile: undefined,
+      runTurnLoop: () => {
+        runs += 1;
+        if (runs === 1) return Promise.resolve({ responseText: "one", turnBudget });
+        return new Promise((resolve) => resumes.push((responseText: string) => resolve({ responseText, turnBudget })));
+      },
+      subscribe: () => () => {},
+    };
+  };
+  const registry = new AgentTypeRegistry(() => config ? new Map([[AGENT_TYPE, {
+    name: AGENT_TYPE,
+    displayName: "General Purpose",
+    description: "Test agent",
+    systemPrompt: "",
+    promptMode: "append",
+    ...config,
+  }]]) : new Map());
+  const notifications = new NotificationManager((message, options) => sent.push({ message, options }));
+  const manager = new SubagentManager({
+    baseCwd: "/tmp",
+    createSubagentSession: async () => newSession() as never,
+    limiter: new ConcurrencyLimiter(() => 4),
+    observer: new SubagentEventsObserver({ appendEntry: () => {}, emit: () => {}, notifications }),
+    registry,
+  });
+  const runtime = {
+    buildSnapshot: () => ({}) as never,
+    getModelInfo: () => ({ modelRegistry: undefined, parentModel: undefined }),
+    getSessionInfo: () => ({ parentSessionFile: "", parentSessionId: "parent" }),
+  };
+  const agentTool = new AgentTool(manager, runtime, { defaultMaxTurns: undefined, maxConcurrent: 4 }, registry, "/tmp");
+  const getResult = new GetResultTool(manager, registry);
+
+  // call runs the subagent tool and returns its text and details.
+  async function call(params: Record<string, unknown>, mode: ExtensionContext["mode"] = "print") {
+    const ctx = { mode, hasUI: mode === "tui" || mode === "rpc" } as ExtensionContext;
+    const result = await agentTool.toToolDefinition().execute("call", { description: "count", prompt: "say one", subagent_type: AGENT_TYPE, ...params }, undefined, undefined, ctx);
+    const first = result.content[0];
+    return { details: result.details as { agentId?: string; status?: string } | undefined, text: first?.type === "text" ? first.text : "" };
+  }
+
+  // release answers the oldest pending resumed run.
+  function release(text: string): void {
+    resumes.shift()?.(text);
+  }
+
+  return { call, getResult, manager, notifications: () => sent.filter(({ message }) => message.customType === NOTIFICATION), release, resumes };
+}
+
+// settle lets every pending promise callback run.
+async function settle(): Promise<void> {
+  for (let round = 0; round < 5; round += 1) await new Promise((resolve) => setTimeout(resolve, 0));
+}
+
+describe("launch routing after agent config resolution", () => {
+  it.each<Pick<AgentConfig, "locked" | "runInBackground">>([
+    { locked: ["run_in_background"], runInBackground: false },
+    { locked: ["run_in_background"] },
+    { locked: true, runInBackground: false },
+  ])("rejects an effective foreground launch in TUI but preserves the lock in headless modes (%j)", async (config) => {
+    const { call, manager } = harness(config);
+    await expect(call({ run_in_background: true }, "tui")).rejects.toThrow("resolves to foreground");
+    expect(manager.listAgents()).toHaveLength(0);
+
+    for (const mode of ["print", "json", "rpc"] as const) {
+      const result = await call({ run_in_background: true }, mode);
+      expect(result.details?.status).toBe("completed");
+      expect(result.text).toContain("parameter was ignored");
+    }
+  });
+
+  it.each<Pick<AgentConfig, "locked" | "runInBackground">>([
+    { runInBackground: false },
+    { locked: ["run_in_background"], runInBackground: true },
+  ])("routes an effective background launch through the background runner in TUI (%j)", async (config) => {
+    const { call, getResult, manager } = harness(config);
+    const result = await call({ run_in_background: true }, "tui");
+    expect(result.details?.status).toBe("background");
+    const id = result.details?.agentId ?? "";
+    await getResult.execute("call", { agent_id: id, wait: true }, new AbortController().signal, undefined, undefined);
+    expect(manager.getRecord(id)?.result).toBe("one");
+  });
+});
+
+describe("TUI resume with run_in_background", () => {
+  it("returns at once with the agent ID and announces the resumed run when it ends", async () => {
+    const { call, getResult, manager, notifications, release, resumes } = harness();
+    const spawned = await call({ prompt: "say one", run_in_background: true });
+    const id = spawned.details?.agentId ?? "";
+    await getResult.execute("call", { agent_id: id, wait: true }, new AbortController().signal, undefined, undefined);
+    expect(manager.getRecord(id)?.result).toBe("one");
+    const before = notifications().length;
+
+    await expect(call({ prompt: "say two", resume: id }, "tui")).rejects.toThrow("requires run_in_background: true for a resume");
+    expect(resumes).toHaveLength(0);
+
+    const resumed = await call({ prompt: "say two", resume: id, run_in_background: true }, "tui");
+    expect(resumed.text).toContain("Agent resumed in background.");
+    expect(resumed.text).toContain(`Agent ID: ${id}`);
+    expect(resumed.text).toContain("You will be notified when this agent completes.");
+    expect(resumed.details).toMatchObject({ agentId: id, status: "background" });
+    expect(resumes).toHaveLength(1);
+    expect(manager.getRecord(id)?.status).toBe("running");
+    expect(notifications()).toHaveLength(before);
+
+    release("two");
+    await settle();
+    expect(manager.getRecord(id)?.result).toBe("two");
+    const nudges = notifications().slice(before);
+    expect(nudges).toHaveLength(1);
+    expect(nudges[0].message.content).toContain("two");
+    expect(nudges[0].options?.triggerTurn).toBe(true);
+  });
+
+  it("announces a resumed run of an agent that first ran in the foreground", async () => {
+    const { call, manager, notifications, release } = harness();
+    await call({ prompt: "say one" });
+    const id = manager.listAgents()[0]?.id ?? "";
+    expect(manager.getRecord(id)?.claimed).toBe(true);
+
+    const resumed = await call({ prompt: "say two", resume: id, run_in_background: true }, "tui");
+    expect(resumed.text).toContain("Agent resumed in background.");
+    release("two");
+    await settle();
+    expect(notifications().map(({ message }) => message.content).join("\n")).toContain("two");
+  });
+
+  it("refuses a background resume of an agent that is still running", async () => {
+    const { call, release } = harness();
+    const spawned = await call({ prompt: "say one", run_in_background: true });
+    const id = spawned.details?.agentId ?? "";
+    await settle();
+    await call({ prompt: "say two", resume: id, run_in_background: true }, "tui");
+
+    const refused = await call({ prompt: "say three", resume: id, run_in_background: true }, "tui");
+    expect(refused.text).toContain("is still running");
+    release("two");
+    await settle();
+  });
+});
+
+describe.each(["json", "print", "rpc"] as const)("resume in %s mode", (mode) => {
+  it.each([
+    ["omitted", {}],
+    ["false", { run_in_background: false }],
+    ["true", { run_in_background: true }],
+  ] as const)("waits and returns the result without a notification (run_in_background: %s)", async (_label, flags) => {
+    const { call, manager, notifications, release, resumes } = harness();
+    const spawned = await call({ prompt: "say one", run_in_background: true }, mode);
+    expect(spawned.details?.status).toBe("background");
+    const id = spawned.details?.agentId ?? "";
+    await manager.waitForAll();
+    const before = notifications().length;
+
+    let returned = false;
+    const pending = call({ prompt: "say two", resume: id, ...flags }, mode).then((result) => {
+      returned = true;
+      return result;
+    });
+    await settle();
+    const started = resumes.length;
+    const returnedBeforeRelease = returned;
+
+    release("two");
+    const resumed = await pending;
+    expect(started).toBe(1);
+    expect(returnedBeforeRelease).toBe(false);
+    expect(resumed.details).toMatchObject({ agentId: id, status: "completed" });
+    expect(resumed.text).toContain(`Agent ID: ${id}`);
+    expect(resumed.text).toContain("two");
+    await settle();
+    expect(notifications()).toHaveLength(before);
+  });
+});
