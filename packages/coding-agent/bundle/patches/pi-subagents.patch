diff -ruN a/test/child-inline-extensions.test.ts b/test/child-inline-extensions.test.ts
--- a/test/child-inline-extensions.test.ts
+++ b/test/child-inline-extensions.test.ts
@@ -0,0 +1,97 @@
+// Tests for the Pi fork's pi-subagents patch. The bundle installs no vitest, so these run under Bun:
+// cd packages/coding-agent/bundle/node_modules/@gotgenes/pi-subagents && bun test ./test
+
+import { afterEach, describe, expect, it } from "bun:test";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { childInlineExtensions } from "#src/session/child-inline-extensions";
+import { loadSettings } from "#src/settings";
+
+const BROWSER_NAMES = ["browser", "browser-use"];
+const BUILTIN_TOOLS = ["read", "bash", "edit", "write", "grep", "find", "ls"];
+const INLINE_EXTENSIONS_KEY = Symbol.for("pi:inline-extensions");
+
+// factory stands in for an extension factory; the filter never calls it.
+const factory = () => {};
+
+// publish sets what the Pi fork's main() would publish.
+function publish(value: unknown): void {
+  (globalThis as Record<symbol, unknown>)[INLINE_EXTENSIONS_KEY] = value;
+}
+
+describe("childInlineExtensions", () => {
+  afterEach(() => {
+    delete (globalThis as Record<symbol, unknown>)[INLINE_EXTENSIONS_KEY];
+  });
+
+  it("gives an agent that lists browser_* the named extensions only", () => {
+    publish([
+      factory,
+      { factory, name: "browser" },
+      { factory, name: "browser-use" },
+      { factory, name: "status" },
+    ]);
+    const names = childInlineExtensions(BROWSER_NAMES, [...BUILTIN_TOOLS, "browser_*"]).map(
+      (input) => (typeof input === "function" ? "" : input.name),
+    );
+    expect(names).toEqual(["browser", "browser-use"]);
+  });
+
+  it("gives an agent that lists * the named extensions only", () => {
+    publish([
+      { factory, name: "browser" },
+      { factory, name: "@gotgenes/pi-subagents" },
+      { factory, name: "codemode", builtin: true },
+    ]);
+    const names = childInlineExtensions(["browser", "codemode"], ["*"]).map((input) =>
+      typeof input === "function" ? "" : input.name,
+    );
+    expect(names).toEqual(["browser", "codemode"]);
+  });
+
+  it("gives nothing to an agent that lists only built-in tools", () => {
+    publish([{ factory, name: "browser" }]);
+    expect(childInlineExtensions(BROWSER_NAMES, BUILTIN_TOOLS)).toEqual([]);
+    expect(childInlineExtensions(BROWSER_NAMES, undefined)).toEqual([]);
+  });
+
+  it("gives nothing when Pi published nothing", () => {
+    expect(childInlineExtensions(BROWSER_NAMES, ["browser_*"])).toEqual([]);
+    publish("not a list");
+    expect(childInlineExtensions(BROWSER_NAMES, ["browser_*"])).toEqual([]);
+  });
+
+  it("gives nothing when no names are configured", () => {
+    publish([{ factory, name: "browser" }]);
+    expect(childInlineExtensions([], ["browser_*"])).toEqual([]);
+  });
+});
+
+describe("childInlineExtensions setting", () => {
+  const dirs: string[] = [];
+
+  afterEach(() => {
+    for (const dir of dirs.splice(0)) rmSync(dir, { force: true, recursive: true });
+  });
+
+  // load reads a global subagents.json holding the given value under childInlineExtensions.
+  function load(value: unknown) {
+    const agentDir = mkdtempSync(join(tmpdir(), "pi-subagents-agent-"));
+    const cwd = mkdtempSync(join(tmpdir(), "pi-subagents-cwd-"));
+    dirs.push(agentDir, cwd);
+    writeFileSync(join(agentDir, "subagents.json"), JSON.stringify({ childInlineExtensions: value }));
+    return loadSettings(agentDir, cwd);
+  }
+
+  it("trims names, drops duplicates, blanks, and non-strings", () => {
+    expect(load([" browser ", "browser", "", 7, null, "browser-use"]).childInlineExtensions).toEqual([
+      "browser",
+      "browser-use",
+    ]);
+  });
+
+  it("drops a value that is not a list", () => {
+    expect(load("browser").childInlineExtensions).toBeUndefined();
+  });
+});
diff -ruN a/test/main-session-tools.test.ts b/test/main-session-tools.test.ts
--- a/test/main-session-tools.test.ts
+++ b/test/main-session-tools.test.ts
@@ -0,0 +1,100 @@
+// Tests for the Pi fork's pi-subagents patch. The bundle installs no vitest, so these run under Bun:
+// cd packages/coding-agent/bundle/node_modules/@gotgenes/pi-subagents && bun test ./test
+
+import { describe, expect, it } from "bun:test";
+import type { AgentSession, SettingsManager } from "@earendil-works/pi-coding-agent";
+import type { AgentConfigLookup } from "#src/config/agent-types";
+import {
+  type CreateSessionOptions,
+  createSubagentSession,
+  type SubagentSessionDeps,
+} from "#src/lifecycle/create-subagent-session";
+import type { ParentSnapshot } from "#src/lifecycle/parent-snapshot";
+import { childToolAllowlist, MAIN_SESSION_TOOLS } from "#src/session/main-session-tools";
+
+const PROTOCOL_TOOLS = ["ask_parent", "notify_parent"];
+const RECURSION_GUARD = ["subagent", "get_subagent_result", "steer_subagent"];
+
+describe("childToolAllowlist", () => {
+  it("passes no allowlist for an agent that lists *", () => {
+    expect(childToolAllowlist([MAIN_SESSION_TOOLS], PROTOCOL_TOOLS)).toBeUndefined();
+    expect(childToolAllowlist(["read", MAIN_SESSION_TOOLS], PROTOCOL_TOOLS)).toBeUndefined();
+  });
+
+  it("appends the protocol tools to any other list", () => {
+    expect(childToolAllowlist(["read", "browser_*"], PROTOCOL_TOOLS)).toEqual([
+      "read",
+      "browser_*",
+      ...PROTOCOL_TOOLS,
+    ]);
+    expect(childToolAllowlist([], [])).toEqual([]);
+  });
+});
+
+describe("createSubagentSession tool selection", () => {
+  // spawn creates a child of an agent with the given tools: list and returns what reached createSession.
+  async function spawn(toolNames: string[]): Promise<CreateSessionOptions> {
+    let captured: CreateSessionOptions | undefined;
+    const session = {
+      bindExtensions: async () => {},
+      messages: [],
+      subscribe: () => () => {},
+    } as unknown as AgentSession;
+    const registry: AgentConfigLookup = {
+      getToolNamesForType: () => toolNames,
+      resolveAgentConfig: (type) => ({
+        description: type,
+        name: type,
+        promptMode: "append",
+        systemPrompt: "",
+        toolNames,
+      }),
+    };
+    const deps: SubagentSessionDeps = {
+      exec: (async () => ({ code: 0, killed: false, stderr: "", stdout: "" })) as never,
+      io: {
+        assemblerIO: { buildAgentPrompt: () => "prompt", loadProjectContext: () => undefined } as never,
+        createLoaderSettingsManager: (parent) => parent,
+        createResourceLoader: () => ({ reload: async () => {} }),
+        createSession: async (options) => {
+          captured = options;
+          return { session };
+        },
+        createSessionManager: () => ({
+          getSessionFile: () => undefined,
+          getSessionId: () => "child",
+          newSession: () => {},
+        }),
+        createSettingsManager: () => ({}) as SettingsManager,
+        deriveSessionDir: () => "/tmp",
+        detectEnv: async () => ({ branch: "", isGitRepo: false, platform: "linux" }),
+        getAgentDir: () => "/tmp",
+      },
+      lifecycle: { bound: () => {}, completed: () => {}, disposed: () => {}, sessionCreated: () => {}, spawning: () => {} },
+      registry,
+      resolvePromptInheritance: () => "full",
+    };
+    const snapshot: ParentSnapshot = {
+      cwd: "/tmp",
+      model: undefined,
+      modelRegistry: { find: () => undefined } as never,
+      systemPrompt: "parent",
+    };
+    await createSubagentSession({ askParent: () => {}, snapshot, type: "general-purpose" }, deps);
+    if (!captured) throw new Error("createSession was not called");
+    return captured;
+  }
+
+  it("gives an agent that lists * the main session's selection, the guard, and ask_parent", async () => {
+    const options = await spawn([MAIN_SESSION_TOOLS]);
+    expect(options.tools).toBeUndefined();
+    expect(options.excludeTools).toEqual(RECURSION_GUARD);
+    expect(options.customTools?.map((tool) => tool.name)).toEqual(["ask_parent"]);
+  });
+
+  it("keeps the allowlist of an agent that names its tools", async () => {
+    const options = await spawn(["read", "browser_*"]);
+    expect(options.tools).toEqual(["read", "browser_*", "ask_parent"]);
+    expect(options.excludeTools).toEqual(RECURSION_GUARD);
+  });
+});
