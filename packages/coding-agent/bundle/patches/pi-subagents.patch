diff -ruN a/src/session/child-inline-extensions.ts b/src/session/child-inline-extensions.ts
--- a/src/session/child-inline-extensions.ts
+++ b/src/session/child-inline-extensions.ts
@@ -0,0 +1,42 @@
+/**
+ * child-inline-extensions.ts - Hand a child every inline extension its parent loaded.
+ *
+ * Pi loads extensions compiled into its binary as inline factories, which a
+ * child's own `DefaultResourceLoader` never discovers on disk. The Pi fork's
+ * `main()` publishes those factories under `Symbol.for("pi:inline-extensions")`,
+ * and a child loads all of them, so it runs the same extensions as its parent.
+ *
+ * Narrow children load the MCP built-in only if their tool list needs it.
+ * pi-subagents itself is excluded: its copy in a child would replace
+ * and then delete the parent's service on `globalThis`. The recursion guard
+ * keeps a child from spawning agents either way.
+ */
+
+import type { InlineExtension } from "@earendil-works/pi-coding-agent";
+
+/** Global key the Pi fork's `main()` publishes its inline extensions under. */
+const INLINE_EXTENSIONS_KEY = Symbol.for("pi:inline-extensions");
+
+/** The name this package carries among the published inline extensions. */
+export const SUBAGENTS_EXTENSION = "@gotgenes/pi-subagents";
+
+/**
+ * Every published inline extension except pi-subagents. A name `loaded`
+ * already holds is skipped, so a Pi built-in the core selected for the child's
+ * tools never loads twice.
+ */
+export function childInlineExtensions(loaded: readonly InlineExtension[] = [], loadUnselectedMcp = false): InlineExtension[] {
+  // A Pi build that publishes nothing leaves the child as it was.
+  const published = (globalThis as Record<symbol, unknown>)[INLINE_EXTENSIONS_KEY];
+  if (!Array.isArray(published)) return [];
+
+  // Only named extensions can be handed over; a bare factory has no name to check.
+  const skipped = new Set([SUBAGENTS_EXTENSION]);
+  for (const input of loaded) {
+    if (typeof input !== "function") skipped.add(input.name);
+  }
+  return (published as InlineExtension[]).filter(
+    (input) => typeof input !== "function" && !skipped.has(input.name) &&
+      (loadUnselectedMcp || input.name !== "mcp" || input.builtin !== true),
+  );
+}
