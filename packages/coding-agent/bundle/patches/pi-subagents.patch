diff -ruN a/src/session/child-inline-extensions.ts b/src/session/child-inline-extensions.ts
--- a/src/session/child-inline-extensions.ts
+++ b/src/session/child-inline-extensions.ts
@@ -0,0 +1,39 @@
+/**
+ * child-inline-extensions.ts - Hand a child the parent's inline extensions it needs.
+ *
+ * Pi loads extensions compiled into its binary as inline factories, which a
+ * child's own `DefaultResourceLoader` never discovers on disk. The Pi fork's
+ * `main()` publishes those factories under `Symbol.for("pi:inline-extensions")`;
+ * `subagents.json` `childInlineExtensions` names the ones a child may load.
+ *
+ * They load only in a child whose `tools:` names a tool outside the seven
+ * built-ins, `*` included. The allowlist would drop their tools anyway, but
+ * their `session_start` and `session_shutdown` handlers would still run in
+ * every child for nothing.
+ */
+
+import type { InlineExtension } from "@earendil-works/pi-coding-agent";
+import { BUILTIN_TOOL_NAMES } from "#src/config/agent-types";
+
+/** Global key the Pi fork's `main()` publishes its inline extensions under. */
+const INLINE_EXTENSIONS_KEY = Symbol.for("pi:inline-extensions");
+
+/** The published inline extensions named in `names`, or none when the agent lists only built-in tools. */
+export function childInlineExtensions(
+  names: readonly string[],
+  toolNames: readonly string[] | undefined,
+): InlineExtension[] {
+  // Nothing is configured, or the agent asks for no extension tool.
+  if (names.length === 0) return [];
+  if (!toolNames?.some((name) => !BUILTIN_TOOL_NAMES.includes(name))) return [];
+
+  // A Pi build that publishes nothing leaves the child as it was.
+  const published = (globalThis as Record<symbol, unknown>)[INLINE_EXTENSIONS_KEY];
+  if (!Array.isArray(published)) return [];
+
+  // Only named extensions can be picked; a bare factory has no name to match.
+  const wanted = new Set(names);
+  return (published as InlineExtension[]).filter(
+    (input) => typeof input !== "function" && wanted.has(input.name),
+  );
+}
diff -ruN a/src/session/main-session-tools.ts b/src/session/main-session-tools.ts
--- a/src/session/main-session-tools.ts
+++ b/src/session/main-session-tools.ts
@@ -0,0 +1,26 @@
+/**
+ * main-session-tools.ts - Give an agent exactly the tools a main Pi session holds.
+ *
+ * An agent's `tools:` list is an allowlist, and Pi activates every registered
+ * tool an allowlist matches on every tool-registry rebuild. A plain `*` pattern
+ * would therefore also activate tools a main session leaves inactive: `grep`,
+ * `find`, `ls`, and any tool an extension deactivates at session start.
+ *
+ * `tools: *` instead passes no allowlist at all, so the child selects its tools
+ * the way a main session does: the `defaultTools` setting plus every extension
+ * tool that activates when it registers. The recursion guard still applies,
+ * because it is a denylist, and the child's protocol tools still register,
+ * because nothing filters them.
+ */
+
+/** The `tools:` entry that gives an agent the main session's own tool selection. */
+export const MAIN_SESSION_TOOLS = "*";
+
+/** The child's tool allowlist, or none when the agent asks for the main session's selection. */
+export function childToolAllowlist(
+  toolNames: readonly string[],
+  protocolTools: readonly string[],
+): string[] | undefined {
+  if (toolNames.includes(MAIN_SESSION_TOOLS)) return undefined;
+  return [...toolNames, ...protocolTools];
+}
