+++ b/src/session/main-session-tools.ts
@@ -0,0 +1,19 @@
+/** The `tools:` entry that copies the parent's active selection at spawn. */
+export const MAIN_SESSION_TOOLS = "*";
+
+/** A child cannot use these tools to spawn or control another child. */
+export const RECURSION_GUARD_TOOLS: readonly string[] = ["subagent", "get_subagent_result", "steer_subagent"];
+
+export function hasMainSessionTools(toolNames: readonly string[]): boolean {
+  return toolNames.includes(MAIN_SESSION_TOOLS);
+}
+
+/** Copy the effective parent loadout for `*`; keep all other allowlists as configured. */
+export function childToolAllowlist(
+  toolNames: readonly string[],
+  parentTools: readonly string[],
+  protocolTools: readonly string[],
+): string[] {
+  if (!hasMainSessionTools(toolNames)) return [...toolNames, ...protocolTools];
+  return [...new Set([...parentTools.filter((name) => !RECURSION_GUARD_TOOLS.includes(name)), ...protocolTools])];
+}
