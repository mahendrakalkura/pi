@@ -0,0 +1,109 @@
+// Tests for the Pi fork's pi-subagents patch. The bundle installs no vitest, so these run under Bun:
+// cd packages/coding-agent/bundle/node_modules/@gotgenes/pi-subagents && bun test ./test
+
+import { afterEach, describe, expect, it } from "bun:test";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { childInlineExtensions } from "#src/session/child-inline-extensions";
+import { loadSettings } from "#src/settings";
+
+const BROWSER_NAMES = ["browser", "browser-use"];
+const BUILTIN_TOOLS = ["read", "bash", "edit", "write", "grep", "find", "ls"];
+const INLINE_EXTENSIONS_KEY = Symbol.for("pi:inline-extensions");
+
+// factory stands in for an extension factory; the filter never calls it.
+const factory = () => {};
+
+// publish sets what the Pi fork's main() would publish.
+function publish(value: unknown): void {
+  (globalThis as Record<symbol, unknown>)[INLINE_EXTENSIONS_KEY] = value;
+}
+
+describe("childInlineExtensions", () => {
+  afterEach(() => {
+    delete (globalThis as Record<symbol, unknown>)[INLINE_EXTENSIONS_KEY];
+  });
+
+  it("gives an agent that lists browser_* the named extensions only", () => {
+    publish([
+      factory,
+      { factory, name: "browser" },
+      { factory, name: "browser-use" },
+      { factory, name: "status" },
+    ]);
+    const names = childInlineExtensions(BROWSER_NAMES, [...BUILTIN_TOOLS, "browser_*"]).map(
+      (input) => (typeof input === "function" ? "" : input.name),
+    );
+    expect(names).toEqual(["browser", "browser-use"]);
+  });
+
+  it("gives an agent that lists * the named extensions only", () => {
+    publish([
+      { factory, name: "browser" },
+      { factory, name: "@gotgenes/pi-subagents" },
+      { factory, name: "codemode", builtin: true },
+    ]);
+    const names = childInlineExtensions(["browser", "codemode"], ["*"]).map((input) =>
+      typeof input === "function" ? "" : input.name,
+    );
+    expect(names).toEqual(["browser", "codemode"]);
+  });
+
+  it("skips a name the core already loads for the child's tools", () => {
+    publish([
+      { factory, name: "browser" },
+      { factory, name: "codemode", builtin: true },
+    ]);
+    const loaded = [{ factory, name: "codemode", builtin: true }];
+    const names = childInlineExtensions(["browser", "codemode"], ["codemode", "browser_*"], loaded).map((input) =>
+      typeof input === "function" ? "" : input.name,
+    );
+    expect(names).toEqual(["browser"]);
+  });
+
+  it("gives nothing to an agent that lists only built-in tools", () => {
+    publish([{ factory, name: "browser" }]);
+    expect(childInlineExtensions(BROWSER_NAMES, BUILTIN_TOOLS)).toEqual([]);
+    expect(childInlineExtensions(BROWSER_NAMES, undefined)).toEqual([]);
+  });
+
+  it("gives nothing when Pi published nothing", () => {
+    expect(childInlineExtensions(BROWSER_NAMES, ["browser_*"])).toEqual([]);
+    publish("not a list");
+    expect(childInlineExtensions(BROWSER_NAMES, ["browser_*"])).toEqual([]);
+  });
+
+  it("gives nothing when no names are configured", () => {
+    publish([{ factory, name: "browser" }]);
+    expect(childInlineExtensions([], ["browser_*"])).toEqual([]);
+  });
+});
+
+describe("childInlineExtensions setting", () => {
+  const dirs: string[] = [];
+
+  afterEach(() => {
+    for (const dir of dirs.splice(0)) rmSync(dir, { force: true, recursive: true });
+  });
+
+  // load reads a global subagents.json holding the given value under childInlineExtensions.
+  function load(value: unknown) {
+    const agentDir = mkdtempSync(join(tmpdir(), "pi-subagents-agent-"));
+    const cwd = mkdtempSync(join(tmpdir(), "pi-subagents-cwd-"));
+    dirs.push(agentDir, cwd);
+    writeFileSync(join(agentDir, "subagents.json"), JSON.stringify({ childInlineExtensions: value }));
+    return loadSettings(agentDir, cwd);
+  }
+
+  it("trims names, drops duplicates, blanks, and non-strings", () => {
+    expect(load([" browser ", "browser", "", 7, null, "browser-use"]).childInlineExtensions).toEqual([
+      "browser",
+      "browser-use",
+    ]);
+  });
+
+  it("drops a value that is not a list", () => {
+    expect(load("browser").childInlineExtensions).toBeUndefined();
+  });
+});
