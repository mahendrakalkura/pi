diff -ruN a/src/lsp/checked-source.ts b/src/lsp/checked-source.ts
--- a/src/lsp/checked-source.ts
+++ b/src/lsp/checked-source.ts
@@ -0,0 +1,16 @@
+import { constants } from "node:fs";
+import { open, realpath } from "node:fs/promises";
+
+/** Read the same regular file that root discovery checked. */
+export async function readCheckedSource(path: string, identity: { dev: bigint; ino: bigint }): Promise<string> {
+  const source = await open(path, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
+  try {
+    const opened = await source.stat({ bigint: true });
+    if (!opened.isFile() || opened.dev !== identity.dev || opened.ino !== identity.ino || (await realpath(path)) !== path) {
+      throw new Error(`LSP file changed before it could be read: ${path}.`);
+    }
+    return await source.readFile("utf8");
+  } finally {
+    await source.close();
+  }
+}
