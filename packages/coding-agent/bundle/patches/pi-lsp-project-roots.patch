diff -ruN a/test/workspace-roots.test.ts b/test/workspace-roots.test.ts
--- a/test/workspace-roots.test.ts
+++ b/test/workspace-roots.test.ts
@@ -0,0 +1,210 @@
+// Tests for the Pi fork's pi-lsp-adapter patch. The bundle installs no vitest, so these run under Bun:
+// cd packages/coding-agent/bundle/node_modules/pi-lsp-adapter && bun test ./test
+
+import { afterEach, beforeEach, describe, expect, it } from "bun:test";
+import { mkdirSync, mkdtempSync, renameSync, rmSync, statSync, symlinkSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import type { LoadLspConfigResult } from "../src/config/loadConfig.ts";
+import { createInstalledServerMetadata } from "../src/install/lockfile.ts";
+import type { LspInstallManager } from "../src/install/manager.ts";
+import { readCheckedSource } from "../src/lsp/checked-source.ts";
+import type { LspConnection, LspServerProcess } from "../src/lsp/client.ts";
+import type { LspProcessRegistry } from "../src/lsp/processRegistry.ts";
+import { LspRuntimeError, LspRuntimeManager } from "../src/lsp/runtimeManager.ts";
+import { BUILTIN_CATALOG } from "../src/registry/builtin.ts";
+import { EventEmitter } from "node:events";
+
+// FAKE_PID is the pid the fake server reports; nothing signals it.
+const FAKE_PID = 4_000_000;
+class FakeServer extends EventEmitter implements LspServerProcess {
+  readonly pid = FAKE_PID;
+  kill() { return true; }
+}
+
+const GO_SOURCE = "package main\n\nfunc main() {}\n";
+
+describe("LspRuntimeManager project roots", () => {
+  let base: string;
+  let home: string;
+  let spawned: string[];
+  let workspace: string;
+
+  beforeEach(() => {
+    base = mkdtempSync(join(tmpdir(), "pi-lsp-roots-"));
+    home = join(base, "home");
+    workspace = join(home, "Repositories", "project");
+    spawned = [];
+    write(join(workspace, "go.mod"), "module project\n");
+  });
+
+  afterEach(() => {
+    rmSync(base, { force: true, recursive: true });
+  });
+
+  // write creates a file and every directory above it.
+  function write(path: string, content = GO_SOURCE): string {
+    mkdirSync(dirname(path), { recursive: true });
+    writeFileSync(path, content);
+    return path;
+  }
+
+  // gitCheckout creates a checkout with a .git directory and one Go file in a subpackage.
+  function gitCheckout(root: string): string {
+    mkdirSync(join(root, ".git"), { recursive: true });
+    return write(join(root, "pkg", "main.go"));
+  }
+
+  // manager returns a runtime manager for the workspace whose gopls starts a fake server and records its root.
+  function manager(initialize?: () => Promise<void>): LspRuntimeManager {
+    const lockfilePath = join(base, "lsp-lock.json");
+    const metadata = createInstalledServerMetadata({ binDir: join(base, "bin"), installer: "system", resolvedCommand: ["gopls"] });
+    writeFileSync(lockfilePath, JSON.stringify({ servers: { gopls: metadata } }));
+    const config: LoadLspConfigResult = {
+      catalog: { servers: { gopls: { ...BUILTIN_CATALOG.servers.gopls, filetypes: ["go", "javascript"] } } },
+      installMode: "off",
+      warmup: false,
+      warnings: [],
+    } as unknown as LoadLspConfigResult;
+    const processRegistry = { register: async () => {}, unregister: async () => {} } as unknown as LspProcessRegistry;
+    return new LspRuntimeManager({
+      config,
+      externalConfig: config,
+      connectionFactory: (process) => ({
+        dispose: () => {},
+        end: () => {},
+        listen: () => {},
+        onNotification: () => ({ dispose: () => {} }),
+        onRequest: () => ({ dispose: () => {} }),
+        sendNotification: async (method: string) => {
+          if (method === "exit") (process as FakeServer).emit("exit", 0, null);
+        },
+        sendRequest: async <R>(method: string) => {
+          if (method === "initialize") await initialize?.();
+          return (method === "initialize" ? { capabilities: { documentSymbolProvider: true } } : []) as R;
+        },
+      } satisfies LspConnection),
+      cwd: workspace,
+      homeDir: home,
+      installManager: {} as LspInstallManager,
+      lockfileOptions: { lockfilePath },
+      ownerId: "test",
+      processRegistry,
+      spawner: (resolved) => {
+        spawned.push(resolved.rootDir);
+        return new FakeServer();
+      },
+    });
+  }
+
+  // refusal returns the error code a documentSymbols call on path fails with.
+  async function refusal(runtime: LspRuntimeManager, path: string): Promise<string | undefined> {
+    try {
+      await runtime.documentSymbols(path);
+      return undefined;
+    } catch (error) {
+      return error instanceof LspRuntimeError ? error.code : String(error);
+    }
+  }
+
+  it("keeps the workspace behavior for a file inside it", async () => {
+    const runtime = manager();
+    const result = await runtime.documentSymbols(write(join(workspace, "cmd", "main.go")));
+    expect(result.rootDir).toBe(workspace);
+  });
+
+  it("serves a file in a review checkout below the home directory at the checkout's git root", async () => {
+    const checkout = join(home, ".cache", "recon", "checkouts", "dashboard-pr-54");
+    const runtime = manager();
+    const result = await runtime.documentSymbols(gitCheckout(checkout));
+    expect(result.rootDir).toBe(checkout);
+  });
+
+  it("serves a file in a /tmp clone at the clone's root marker", async () => {
+    const clone = join(base, "pr47");
+    write(join(clone, "go.mod"), "module pr47\n");
+    const runtime = manager();
+    const result = await runtime.documentSymbols(gitCheckout(clone));
+    expect(result.rootDir).toBe(clone);
+    expect(result.rootDir.startsWith(tmpdir())).toBe(true);
+  });
+
+  it("detects a Node shebang on an extensionless script in another checkout", async () => {
+    const root = join(base, "scripts-checkout");
+    gitCheckout(root);
+    const file = write(join(root, "script"), "#!/usr/bin/env node\nconst greeting = 1;\n");
+    const runtime = manager();
+    expect((await runtime.documentSymbols(file)).rootDir).toBe(root);
+    expect(spawned).toEqual([root]);
+  });
+
+  it("runs one server per root", async () => {
+    const first = join(base, "first");
+    const second = join(base, "second");
+    const file = gitCheckout(first);
+    symlinkSync(first, join(base, "alias"));
+    const runtime = manager();
+    await runtime.documentSymbols(file);
+    await runtime.documentSymbols(join(base, "alias", "pkg", "main.go"));
+    await runtime.documentSymbols(write(join(first, "other.go")));
+    await runtime.documentSymbols(gitCheckout(second));
+    await runtime.documentSymbols(write(join(workspace, "main.go")));
+    expect(spawned).toEqual([first, second, workspace]);
+    expect(runtime.activeClients().map((client) => client.rootDir)).toEqual([first, second, workspace]);
+  });
+
+  it("refuses a file outside the workspace that sits in no project", async () => {
+    const runtime = manager();
+    expect(await refusal(runtime, write(join(home, "notes", "main.go")))).toBe("outside-workspace");
+    expect(await refusal(runtime, write(join(base, "loose", "main.go")))).toBe("outside-workspace");
+    expect(spawned).toEqual([]);
+  });
+
+  it("refuses a file whose only root is the home directory", async () => {
+    mkdirSync(join(home, ".git"), { recursive: true });
+    const runtime = manager();
+    expect(await refusal(runtime, write(join(home, "notes", "main.go")))).toBe("outside-workspace");
+    expect(spawned).toEqual([]);
+  });
+
+  it("rejects forbidden root aliases and non-regular targets", async () => {
+    const runtime = manager();
+    symlinkSync(home, join(base, "home-link"));
+    symlinkSync("/", join(base, "root-link"));
+    for (const path of ["home-link", "root-link"]) {
+      await expect(runtime.documentSymbols(join(base, path))).rejects.toThrow("filesystem root or home directory");
+    }
+    mkdirSync(join(workspace, "dir.go"));
+    await expect(runtime.documentSymbols("dir.go")).rejects.toThrow("requires a regular file");
+    expect(spawned).toEqual([]);
+  });
+
+  it("checks the descriptor against the file that was selected before a path replacement", async () => {
+    const source = write(join(workspace, "checked.go"));
+    const identity = statSync(source, { bigint: true });
+    expect(await readCheckedSource(source, identity)).toBe(GO_SOURCE);
