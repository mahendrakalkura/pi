diff -ruN a/test/child-tools.test.ts b/test/child-tools.test.ts
--- a/test/child-tools.test.ts
+++ b/test/child-tools.test.ts
@@ -0,0 +1,24 @@
+import { describe, expect, it } from "bun:test";
+import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
+import lsp from "../src/index.ts";
+
+const SERVER_COMMANDS = ["before_agent_start", "tool_call", "session_start"];
+
+describe("LSP read-only child", () => {
+  it("does not read LSP config, warm up, or claim tools when none are allowed", async () => {
+    const listeners = new Map<string, (event: unknown, ctx: ExtensionContext) => unknown>();
+    const checked: string[] = [];
+    lsp({
+      on: (name: string, fn: (event: unknown, ctx: ExtensionContext) => unknown) => listeners.set(name, fn),
+      isToolAllowed: (name: string) => { checked.push(name); return name === "read"; },
+      registerCommand: () => {},
+      registerTool: () => {},
+    } as unknown as ExtensionAPI);
+    const ctx = new Proxy({}, { get: (_, key) => { throw new Error(`Read-only child used ${String(key)}`); } }) as ExtensionContext;
+    for (const name of SERVER_COMMANDS) expect(listeners.has(name)).toBe(true);
+    expect(await listeners.get("session_start")?.({}, ctx)).toBeUndefined();
+    expect(listeners.get("before_agent_start")?.({ systemPrompt: "unchanged" }, ctx)).toBeUndefined();
+    expect(listeners.get("tool_call")?.({ toolName: "read", input: { path: "fixture.go" } }, ctx)).toBeUndefined();
+    expect(checked).toContain("lsp_document_symbols");
+  });
+});
