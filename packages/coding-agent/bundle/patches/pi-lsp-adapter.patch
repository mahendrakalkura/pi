+async function withMutation<T>(path: string, operation: () => Promise<T>): Promise<T> {
+  const run = (mutationQueues.get(path) ?? Promise.resolve()).then(operation);
+  const settled = run.then(() => undefined, () => undefined);
+  mutationQueues.set(path, settled);
+  try {
+    return await run;
+  } finally {
+    if (mutationQueues.get(path) === settled) mutationQueues.delete(path);
+  }
+}
